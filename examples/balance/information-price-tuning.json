      "estimateErrorRate": 0.3,
      "interestThreshold": 0.65,
      "minimumExpectedMargin": 0.08,
      "reserveCashRate": 0.35,
      "gradeInterestBonus": 0.15,
      "minimumBudget": 30000,
      "circumstanceDensity": 0.9,
      "circumstanceMinimumRatio": 0.45,
      "circumstanceMaximumRatio": 1.8,
      "budgetMinimumRatio": 0.6,
      "budgetMaximumRatio": 1.2,
      "marketBidRatio": 0.92
    },
    "categories": ["art", "relic", "machinery", "curio"],
    "grades": [
      { "id": "common", "weight": 0.3, "informationPriority": 0, "baseValue": 1500, "demandMinimum": 0.95, "demandMaximum": 1.1 },
      { "id": "rare", "weight": 0.43, "informationPriority": 1, "baseValue": 4000, "demandMinimum": 0.8, "demandMaximum": 1.35 },
      { "id": "epic", "weight": 0.195, "informationPriority": 2, "baseValue": 12000, "demandMinimum": 0.6, "demandMaximum": 1.75 },
      { "id": "legendary", "weight": 0.075, "informationPriority": 3, "baseValue": 25000, "demandMinimum": 0.4, "demandMaximum": 2.4 }
    ]
  }
