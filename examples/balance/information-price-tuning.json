{
  "provider": "auction-economy-v1",
  "mode": "tune",
  "seeds": [11, 23, 42, 71, 101],
  "runs": 300,
  "maxCandidates": 144,
  "spec": {
    "balanceId": "information-price-tuning-v1",
    "objective": "Search appraisal and demand information prices so that neither an always-buy nor an always-ignore strategy dominates a selective buyer.",
    "parameters": {
      "appraisalPriceRate": 0.05,
      "demandPriceAssetRate": 0.01
    },
    "parameterSpace": [
      {
        "parameterId": "appraisalPriceRate",
        "path": "information/appraisalPriceRate",
        "minimum": 0.01,
        "maximum": 0.12,
        "step": 0.01
      },
      {
        "parameterId": "demandPriceAssetRate",
        "path": "information/demandPriceAssetRate",
        "minimum": 0.002,
        "maximum": 0.024,
        "step": 0.002
      }
    ],
    "metrics": [
      { "metricId": "informationTransactionAdvantage", "minimum": 3, "maximum": 20, "weight": 3 },
      { "metricId": "informedRuinRate", "minimum": 0, "maximum": 8, "weight": 2 },
      { "metricId": "selectiveInformationSpendRate", "minimum": 3, "maximum": 40, "weight": 2 },
      { "metricId": "selectiveVsAlwaysBuyRoiAdvantage", "minimum": 0, "maximum": null, "weight": 2 },
      { "metricId": "selectiveVsAlwaysIgnoreRoiAdvantage", "minimum": 0, "maximum": null, "weight": 2 }
    ],
    "constraints": [
      "The always-buy policy (EVERY_LOT appraisal+demand) must not weakly dominate the selective policy - buying information on every lot regardless of priority must not be the optimal strategy.",
      "The always-ignore policy (blind, no purchases) must not weakly dominate the selective policy - skipping information entirely must not be the optimal strategy.",
      "Report distributions and failure rates across seeds instead of relying on one mean."
    ],
    "search": {
      "deterministic": true,
      "seed": "42",
      "strategy": "explicit-grid"
    },
    "simulation": {
      "horizon": 12,
      "runsPerSeed": 300,
      "seeds": [11, 23, 42, 71, 101],
      "policies": [
        { "id": "blind", "information": [], "acquisition": "EVERY_LOT" },
        { "id": "informed", "information": ["appraisal", "demand"], "acquisition": "EVERY_LOT" },
        { "id": "selective", "information": ["appraisal", "demand"], "acquisition": "SELECTIVE", "maxPurchasesPerDay": 2, "minimumPriority": 1 }
      ]
    }
  },
  "baseline": {
    "schemaVersion": 1,
    "economy": {
      "startingAssets": 20000,
      "days": 12,
      "saleFeeRate": 0.05,
      "expectedDemandMultiplier": 1.05,
      "ruinThresholdRatio": 0.1
    },
    "auction": {
      "lotsPerDay": 8,
      "startBidRatio": 0.5,
      "minimumIncrementRate": 0.1
    },
    "player": {
      "targetMarginRate": 0.08
    },
    "information": {
      "blindValueErrorRate": 0.35,
      "appraisalErrorRate": 0.2,
      "demandErrorRate": 0.15,
      "appraisalPriceRate": 0.05,
      "demandPriceAssetRate": 0.01
    },
    "bots": {
